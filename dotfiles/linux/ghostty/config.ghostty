theme = "light:Horizon Bright,dark:Broadcast"

font-family = "JetBrainsMono NFM Regular"

font-size = 20

window-padding-x = 10
window-padding-y = 10

window-decoration = true

cursor-style = block

adjust-cell-height = 35%

mouse-scroll-multiplier = 2

copy-on-select = clipboard

window-padding-balance = true

window-save-state = always

# Opaque by default: Ghostty can't blur the background on GNOME, so
# translucency there is just see-through and hurts readability. Override
# in the private repo if your compositor supports blur (e.g. KDE Plasma).
background-opacity = 1.0

